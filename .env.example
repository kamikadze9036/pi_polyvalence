PORT=3000

SQL_SERVER=replace-with-cyclades-sql-host
# Set this to the Cyclades SQL host/IP reachable from the deployment VM.
SQL_PORT=1433
# Use SQL_INSTANCE only when connecting through SQL Server Browser instead of a fixed port.
# SQL_INSTANCE=SQLSISE
SQL_DATABASE=SUIVPRO
SQL_USER=cyclades
SQL_PASSWORD=replace-with-real-password
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
